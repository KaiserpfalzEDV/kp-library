<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20230118-rlichti-001" author="rlichti">
        <createTable tableName="MEDIUMS">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"
                            unique="true" uniqueConstraintName="MEDIUMS_ID_UK"
                            primaryKey="true" primaryKeyName="MEDIUMS_PK"
                />
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="DTYPE" type="VARCHAR(31)" defaultValue="MEDIUM">
                <constraints nullable="false" notNullConstraintName="MEDIUMS_DTYPE_NN"/>
            </column>

            <column name="CREATED" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="MODIFIED" type="TIMESTAMP"/>
            <column name="REVISIONED" type="TIMESTAMP"/>

            <column name="NAMESPACE" type="VARCHAR(100)">
                <constraints nullable="false" notNullConstraintName="MEDIUMS_NAMESPACE_NN"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false" notNullConstraintName="MEDIUMS_NAME_NN"/>
            </column>

            <column name="EAN" type="VARCHAR(16)">
                <constraints nullable="false" notNullConstraintName="MEDIUMS_EAN_NN"/>
            </column>
        </createTable>

        <createTable tableName="ASSETS">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"
                            unique="true" uniqueConstraintName="ASSETS_ID_UK"
                            primaryKey="true" primaryKeyName="ASSETS_PK"
                />
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="0">
                <constraints nullable="false" notNullConstraintName="ASSETS_VERSION_NN"/>
            </column>

            <column name="CREATED" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false" notNullConstraintName="ASSETS_CREATED_NN"/>
            </column>
            <column name="MODIFIED" type="TIMESTAMP"/>
            <column name="REVISIONED" type="TIMESTAMP"/>

            <column name="MEDIUM_ID" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="ASSETS_MEDIUM_NN"/>
            </column>

            <column name="COUNTER" type="INT">
                <constraints nullable="false" notNullConstraintName="ASSETS_COUNTER_NN"/>
            </column>

            <column name="ACQUISITION_DATE" type="TIMESTAMP">
                <constraints nullable="false" notNullConstraintName="ASSETS_ACQUISITION_NN"/>
            </column>

            <column name="LOCATION_ID" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="ASSETS_LOCATION_NN"/>
            </column>
        </createTable>

        <createTable tableName="BORROWS">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"
                            unique="true" uniqueConstraintName="BORROWS_ID_UK"
                            primaryKey="true" primaryKeyName="BORROWS_PK"
                />
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="0">
                <constraints nullable="false" notNullConstraintName="BORROWS_VERSION_NN"/>
            </column>

            <column name="USER_ID" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="BORROWS_USER_NN"/>
            </column>

            <column name="ASSET_ID" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="BORROWS_ASSET_NN"/>
            </column>

            <column name="BORROW_DATE" type="TIMESTAMP">
                <constraints nullable="false" notNullConstraintName="BORROWS_DATE_NN"/>
            </column>
            <column name="LATEST_RETURN" type="TIMESTAMP">
                <constraints nullable="false" notNullConstraintName="BORROWS_LATEST_RETURN_NN"/>
            </column>
        </createTable>

        <createTable tableName="BORROWHISTORY">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"
                            unique="true" uniqueConstraintName="BORROWHISTORY_ID_UK"
                            primaryKey="true" primaryKeyName="BORROWHISTORY_PK"
                />
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="0">
                <constraints nullable="false" notNullConstraintName="BORROWHISTORY_VERSION_NN"/>
            </column>

            <column name="USER_ID" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="BORROWHISTORY_USER_NN"/>
            </column>
            <column name="ASSET_ID" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="BORROWHISTORY_ASSET_NN"/>
            </column>

            <column name="BORROW_DATE" type="TIMESTAMP">
                <constraints nullable="false" notNullConstraintName="BORROWHISTORY_BORROW_NN"/>
            </column>
            <column name="RETURN_DATE" type="TIMESTAMP">
                <constraints nullable="false" notNullConstraintName="BORROWHISTORY_RETURN_NN"/>
            </column>
        </createTable>

        <createTable tableName="LOCATIONS">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"
                            unique="true" uniqueConstraintName="LOCATIONS_ID_UK"
                            primaryKey="true" primaryKeyName="LOCATIONS_PK"
                />
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="CREATED" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="MODIFIED" type="TIMESTAMP"/>
            <column name="REVISIONED" type="TIMESTAMP"/>

            <column name="NAMESPACE" type="VARCHAR(100)">
                <constraints nullable="false" notNullConstraintName="LOCATIONS_NAMESPACE_NN"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false" notNullConstraintName="LOCATIONS_NAME_NN"/>
            </column>

            <column name="LOCATION_TYPE" type="VARCHAR(20)">
                <constraints nullable="false" notNullConstraintName="LOCATIONS_TYPE_NN"/>
            </column>
            <column name="PART_OF" type="BIGINT"/>
        </createTable>


        <createTable tableName="USERS">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"
                            unique="true" uniqueConstraintName="USERS_ID_UK"
                            primaryKey="true" primaryKeyName="USERS_PK"
                />
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="CREATED" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="MODIFIED" type="TIMESTAMP"/>
            <column name="REVISIONED" type="TIMESTAMP"/>

            <column name="NAMESPACE" type="VARCHAR(100)">
                <constraints nullable="false" notNullConstraintName="USERS_NAMESPACE_NN"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false" notNullConstraintName="USERS_NAME_NN"/>
            </column>
            <column name="IDP_NAME" type="VARCHAR(1000)">
                <constraints nullable="false" notNullConstraintName="USERS_IDP_NAME_NN" />
            </column>
        </createTable>


        <addUniqueConstraint constraintName="ASSETS_MEDIUM_UK"
                            tableName="ASSETS" columnNames="MEDIUM_ID,COUNTER"/>

        <addUniqueConstraint constraintName="BORROWS_UK"
                            tableName="BORROWS" columnNames="ASSET_ID,USER_ID"/>

        <addUniqueConstraint constraintName="MEDIUMS_NAME_UK"
                            tableName="MEDIUMS" columnNames="NAMESPACE,NAME"/>

        <addUniqueConstraint constraintName="MEDIUMS_EAN_UK"
                            tableName="MEDIUMS" columnNames="EAN"/>

        <addUniqueConstraint constraintName="LOCATIONS_NAME_UK"
                            tableName="LOCATIONS" columnNames="NAMESPACE,NAME"/>

        <addUniqueConstraint constraintName="USERS_NAME_UK"
                            tableName="USERS" columnNames="NAMESPACE,NAME"/>

        <addUniqueConstraint constraintName="USERS_IDP_NAME_UK"
                            tableName="USERS" columnNames="IDP_NAME"/>


        <createIndex tableName="ASSETS" indexName="ASSETS_LOCATION_IDX">
            <column name="LOCATION_ID"/>
        </createIndex>

        <createIndex tableName="ASSETS" indexName="ASSETS_ACQUISITION_IDX">
            <column name="ACQUISITION_DATE"/>
        </createIndex>

        <createIndex tableName="BORROWS" indexName="BORROWS_BORROW_IDX">
            <column name="BORROW_DATE"/>
        </createIndex>

        <createIndex tableName="BORROWS" indexName="BORROWS_RETURN_IDX">
            <column name="LATEST_RETURN"/>
        </createIndex>

        <createIndex tableName="LOCATIONS" indexName="LOCATIONS_PART_OF_IDX">
            <column name="PART_OF"/>
        </createIndex>


        <addForeignKeyConstraint
                constraintName="ASSETS_MEDIUMS_FK"
                baseTableName="ASSETS" baseColumnNames="MEDIUM_ID"
                referencedTableName="MEDIUMS" referencedColumnNames="ID"/>

        <addForeignKeyConstraint
                constraintName="ASSETS_LOCATIONS_FK"
                baseTableName="ASSETS" baseColumnNames="LOCATION_ID"
                referencedTableName="LOCATIONS" referencedColumnNames="ID"/>

        <addForeignKeyConstraint
                constraintName="BORROWS_USERS_FK"
                baseTableName="BORROWS" baseColumnNames="USER_ID"
                referencedTableName="USERS" referencedColumnNames="ID"/>

        <addForeignKeyConstraint
                constraintName="BORROWS_ASSETS_FK"
                baseTableName="BORROWS" baseColumnNames="ASSET_ID"
                referencedTableName="ASSETS" referencedColumnNames="ID"/>

        <addForeignKeyConstraint
                constraintName="BORROWHISTORY_USERS_FK"
                baseTableName="BORROWHISTORY" baseColumnNames="USER_ID"
                referencedTableName="USERS" referencedColumnNames="ID"/>

        <addForeignKeyConstraint
                constraintName="BORROWHISTORY_ASSETS_FK"
                baseTableName="BORROWHISTORY" baseColumnNames="ASSET_ID"
                referencedTableName="ASSETS" referencedColumnNames="ID"/>

        <addForeignKeyConstraint
                constraintName="LOCATIONS_PARTOF_FK"
                baseTableName="LOCATIONS" baseColumnNames="PART_OF"
                referencedTableName="LOCATIONS" referencedColumnNames="ID"/>

        <rollback>
            <dropUniqueConstraint constraintName="USERS_ID_UK" tableName="USERS"/>
            <dropUniqueConstraint constraintName="MEDIUMS_ID_UK" tableName="MEDIUMS"/>
            <dropUniqueConstraint constraintName="ASSETS_ID_UK" tableName="ASSETS"/>
            <dropUniqueConstraint constraintName="BORROWS_ID_UK" tableName="BORROWS"/>
            <dropUniqueConstraint constraintName="BORROWHISTORY_ID_UK" tableName="BORROWHISTORY"/>
            <dropUniqueConstraint constraintName="LOCATIONS_ID_UK" tableName="LOCATIONS"/>

            <dropUniqueConstraint constraintName="USERS_NAME_UK" tableName="LIBRARY"/>
            <dropUniqueConstraint constraintName="USERS_IDP_NAME_UK" tableName="LIBRARY"/>
            <dropUniqueConstraint constraintName="MEDIUMS_NAME_UK" tableName="LIBRARY"/>
            <dropUniqueConstraint constraintName="MEDIUMS_EAN_UK" tableName="LIBRARY"/>
            <dropUniqueConstraint constraintName="ASSETS_MEDIUM_UK" tableName="LIBRARY"/>
            <dropUniqueConstraint constraintName="BOROWS_UK" tableName="LIBRARY"/>
            <dropUniqueConstraint constraintName="LOCATIONS_NAME_UK" tableName="LIBRARY"/>

            <dropIndex indexName="ASSETS_LOCATION_IDX" tableName="LOCATIONS"/>
            <dropIndex indexName="ASSETS_ACQUISITION_IDX" tableName="ACQUISITION_DATE"/>
            <dropIndex indexName="BORROWS_BORROW_IDX" tableName="BORROW_DATE"/>
            <dropIndex indexName="BORROWS_RETURN_IDX" tableName="LATEST_RETURN"/>
            <dropIndex indexName="LOCATIONS_PART_OF_IDX" tableName="PART_OF"/>

            <dropAllForeignKeyConstraints baseTableName="USERS"/>
            <dropAllForeignKeyConstraints baseTableName="MEDIUMS"/>
            <dropAllForeignKeyConstraints baseTableName="ASSETS"/>
            <dropAllForeignKeyConstraints baseTableName="BORROWS"/>
            <dropAllForeignKeyConstraints baseTableName="BORROWHISTORY"/>
            <dropAllForeignKeyConstraints baseTableName="LOCATIONS"/>

            <dropTable tableName="USERS"/>
            <dropTable tableName="MEDIUMS"/>
            <dropTable tableName="ASSETS"/>
            <dropTable tableName="BORROWS"/>
            <dropTable tableName="BORROWHISTORY"/>
            <dropTable tableName="LOCATION"/>
        </rollback>

        <comment>Base installation for v1.</comment>
    </changeSet>

    <changeSet id="20230118-rlichti-002" author="rlichti">
        <loadUpdateData primaryKey="ID" tableName="LOCATIONS"
                        file="locations.csv" relativeToChangelogFile="true" separator=";"/>
        <comment>Base Data</comment>
    </changeSet>

    <changeSet id="tag-v1.0.0" author="rlichti">
        <tagDatabase tag="v1.0.0"/>
    </changeSet>
</databaseChangeLog>